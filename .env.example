# --- API (set these in Vercel > Project > Settings > Environment Variables)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/crayon?sslmode=require
JWT_SECRET=generate-a-long-random-string
HUB_SSO_SECRET=same-secret-the-group-app-hub-uses-to-sign-crayon-erp-tokens
TALLY_CONNECTOR_KEY=generate-another-long-random-string
APP_ENV=production
COOKIE_SECURE=1
SESSION_HOURS=12
